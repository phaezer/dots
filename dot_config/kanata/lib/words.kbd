(defalias
  ;; word macros
  app  (macro a p p l i c a t i o n)
  bcz  (macro b e c a u s e)
  bltn (macro b u i l t i n)
  brek (macro b r e a k)
  cla  (macro c l a s s)
  cnf  (macro c o n f i g u r a t i o n)
  cnt  (macro c o n t i n u e)
  def  (macro d e f a u l t)
  dfn  (macro d e f i n i t i o n)
  env  (macro e n v i r o n m e n t)
  flt  (macro f l o a t)
  fore (macro f o r e a c h)
  fuc  (macro f u n c t i o n)
  ifel (macro i f e l s e)
  imp  (macro i m p o r t)
  inc  (macro i n c l u d e)
  int  (macro i n t e g e r)
  mod  (macro m o d u l e)
  obj  (macro o b j e c t)
  prt  (macro p r i n t)
  ques (macro q u e s t i o n)
  req  (macro r e q u i r e)
  rtr  (macro r e t u r n)
  str  (macro s t r i n g)
  swch (macro s w i t c h)
  tmpl (macro t e m p l a t e)
  unde (macro u n d e f i n e d)
  ver  (macro v e r s i o n)
  whle (macro w h i l e)

  ;; names and identifiers
  ansb (macro a n s i b l e)
  k8s  (macro k u b e r n e t e s)
  phz  (macro p h a e z e r)
  gthb (macro g i t h u b)
  tf   (macro t e r r a f o r m)
  dock (macro d o c k e r)

  ;; commonly used domain macros
  dcom (macro . c o m)
  dnet (macro . n e t)
  dorg (macro . o r g)
  gmal (macro @@ g m a i l . c o m)
  http (macro h t t p s @: / /)
  lclh (macro l o c a l h o s t)
  phzi (macro p h a e z e r . i o)
  plsr (macro p l s r . i o)

  ;; frequent comment flags
  #FIX (macro S-(f i x ;) spc)
  #NOT (macro S-(n o t e ;) spc)
  #TDO (macro S-(t o d o ;) spc)
)

(t! seq vk-application (a p p) (macro a p p l i c a t i o n))
(t! seq vk-because (b c) (macro b e c a u s e))
(t! seq vk-configuration (c o n f) (macro c o n f i g u r a t i o n))
(t! seq vk-continue (c o n t) (macro c o n t i n u e))
(t! seq vk-definition (d f i) (macro d e f i n i t i o n))
(t! seq vk-environment (e n v) (macro e n v i r o n m e n t))
(t! seq vk-module (m o d) (macro m o d u l e))
(t! seq vk-question (q u) (macro q u e s t i o n))
(t! seq vk-version (v e r) (macro v e r s i o n))
(t! seq vk-dotcom (. c) (macro . c o m))
(t! seq vk-dotnet (. n) (macro . n e t))
(t! seq vk-dotorg (. o) (macro . o r g))
(t! seq vk-github (g h) (macro g i t h u b))
(t! seq vk-gmail (S-2 g) (macro S-2 g m a i l . c o m))
(t! seq vk-kubernetes (k u) (macro k u b e r n e t e s))
(t! seq vk-localhost (l o c) (macro l o c a l h o s t))
(t! seq vk-phaezer.io (p h .) (macro p h a e z e r . i o))
(t! seq vk-plsr.io (p l .) (macro p l s r . i o))
(t! seq vk-ansible (a n s) (macro a n s i b l e))
(t! seq vk-ansible.builtin (a n b) (macro a n s i b l e . b u i l t i n))
(t! seq vk-break (b r) (macro b r e a k))
(t! seq vk-builtin (b u i) (macro b u i l t i n))
(t! seq vk-class (c l) (macro c l a s s))
(t! seq vk-default (d f a) (macro d e f a u l t))
(t! seq vk-else (e l) (macro e l s e))
(t! seq vk-float (f l) (macro f l o a t))
(t! seq vk-foreach (f o r) (macro f o r e a c h))
(t! seq vk-function (f u) (macro f u n c t i o n))
(t! seq vk-https (h t t) (macro h t t p s S-; / /))
(t! seq vk-import (i m p) (macro i m p o r t))
(t! seq vk-include (i n c) (macro i n c l u d e))
(t! seq vk-integer (i n t) (macro i n t e g e r))
(t! seq vk-object (o b) (macro o b j e c t))
(t! seq vk-phaezer (p h a) (macro p h a e z e r))
(t! seq vk-print (p r) (macro p r i n t))
(t! seq vk-return (r e) (macro r e t u r n))
(t! seq vk-switch (s w) (macro s w i t c h))
(t! seq vk-template (t e m) (macro t e m p l a t e))
(t! seq vk-undefined (u n d) (macro u n d e f i n e d))
(t! seq vk-while (w h) (macro w h i l e))
(t! seq vk-#FIX (S-f) (macro S-(f i x ;) spc))
(t! seq vk-#NOT (S-n) (macro S-(n o t e ;) spc))
(t! seq vk-#TDO (S-t) (macro S-(t o d o ;) spc))