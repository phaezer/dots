(defvar
 ;; autoshift
  to-as 175
)

(deftemplate auto-shift (key)
  (tap-hold-press-timeout $to-as $to-as $key $key (concat "S-" $key))
)

;; auto-shifted keys
(defalias
  sq (t! auto-shift q)
  sw (t! auto-shift w)
  se (t! auto-shift e)
  sr (t! auto-shift r)
  st (t! auto-shift t)
  sy (t! auto-shift y)
  su (t! auto-shift u)
  si (t! auto-shift i)
  so (t! auto-shift o)
  sp (t! auto-shift p)
  sa (t! auto-shift a)
  ss (t! auto-shift s)
  sd (t! auto-shift d)
  sf (t! auto-shift f)
  sg (t! auto-shift g)
  sh (t! auto-shift h)
  sj (t! auto-shift j)
  sk (t! auto-shift k)
  sl (t! auto-shift l)
  sz (t! auto-shift z)
  sx (t! auto-shift x)
  sc (t! auto-shift c)
  sv (t! auto-shift v)
  sb (t! auto-shift b)
  sn (t! auto-shift n)
  sm (t! auto-shift m)

  s, (t! auto-shift ,)
  s. (t! auto-shift .)
  s` (t! auto-shift `)
  s; (t! auto-shift ;)
  s' (t! auto-shift ')
  s/ (t! auto-shift /)
  s1 (t! auto-shift 1)
  s2 (t! auto-shift 2)
  s3 (t! auto-shift 3)
  s4 (t! auto-shift 4)
  s5 (t! auto-shift 5)
  s6 (t! auto-shift 6)
  s7 (t! auto-shift 7)
  s8 (t! auto-shift 8)
  s9 (t! auto-shift 9)
  s0 (t! auto-shift 0)
  s- (t! auto-shift -)
  s= (t! auto-shift =)
  s[ (t! auto-shift [)
  s] (t! auto-shift ])
  s\ (t! auto-shift \)
)