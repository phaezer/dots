(include "lib/common.kbd")
(include "secrets.kbd")

(defcfg
  ;; required for chordsv2
  concurrent-tap-hold yes
  sequence-timeout 1000
)


(defsrc
  `    1    2    3    4    5    6    7    8    9    0    -    =   bks
  tab  q    w    e    r    t    y    u    i    o    p    [    ]     \
  caps a    s    d    f    g    h    j    k    l    ;    '        ret
  lsft z    x    c    v    b    n    m    ,    .    /            rsft
      lctl lalt lmet            spc           rmet ralt
)

(defvar
  ;; --- timings ---
  ;; taps
  to-tap-s 50
  to-tap-m 100
  to-tap-l 150

  ;; holds
  to-hld-s 200
  to-hld-m 300
  to-hld-l 400

  mod-tap-immediate (
    ` 1 2 3 4 5 6 7 8 9 0 - =
    [ ] \ ; , . /
    spc tab ret bks
    rsft lsft lctl rctl lalt ralt lmet rmet
    up down left right
  )
)


(deftemplate mod-tap (char mod timeout)
  (switch
    ((key-timing 3 less-than 200)) $char break
    () (tap-hold-release-keys $timeout $timeout $char $mod $mod-tap-immediate) break
  )
)

(deftemplate hrm-l (char mod timeout)
  (t! mod-tap $char (multi $mod (layer-while-held left-hrm-held)) $timeout)
)

(deftemplate hrm-r (char mod timeout)
  (t! mod-tap $char (multi $mod (layer-while-held right-hrm-held)) $timeout)
)

;; common aliases
(defalias
  ;; --- multi ---
  meh (multi lctl lalt lsft)
  hyp (multi lctl lalt lsft lmet)

  ;; layers
  SYM (layer-toggle sym)
  SYM2 (layer-toggle sym2)
  NUM (layer-toggle num)
  FN (layer-toggle fn)
  SEC (layer-toggle sec)

  toNR (layer-switch nohr)
  toBS (layer-switch base)
  toAS (layer-switch as)
  toNM (layer-switch num)
  ;; one shot layers
  oSEC (one-shot-release 1000 @SEC)

  ;; capsword
  cpw (caps-word-toggle 1000)

  ;; thumbs
  ;; hold space for symbol layer
  spc (tap-hold 150 150 spc @SYM)
  ;; spc with a longer tap-hold
  spcl (tap-hold $to-hld-l $to-hld-l spc @SYM)

  lmet (tap-hold-press $to-tap-m $to-hld-s bks lmet)
  rmet (tap-hold-press $to-tap-m $to-hld-s ret rmet)
  rsft (tap-hold-press $to-tap-m $to-hld-s sldr rsft)
  ralt (tap-hold-press $to-tap-m $to-hld-s rpt-any ralt)
  lalt (tap-hold-press $to-tap-m $to-hld-s rpt-any lalt)
)

(defvirtualkeys
  vk-capsword (caps-word-toggle 1000)
)

(defseq
  vk-capsword (lsft)
)


;; home row mods and mod-tap keys
(defalias
  ;; mod-tap keys
  g (t! mod-tap g @FN $to-hld-l)
  h (t! mod-tap h @FN $to-hld-l)

  ;; home row mods
  a (t! hrm-l a lctl $to-hld-m)
  s (t! hrm-l s lalt $to-hld-m)
  d (t! hrm-l d lmet $to-hld-l)
  f (t! hrm-l f lsft $to-hld-s)
  j (t! hrm-r j rsft $to-hld-s)
  k (t! hrm-r k rmet $to-hld-l)
  l (t! hrm-r l ralt $to-hld-m)
  ; (t! hrm-r ; rctl $to-hld-m)

  ;; hyp / meh
  z (t! mod-tap z @meh $to-hld-l)
  x (t! mod-tap x @hyp $to-hld-l)
  . (t! mod-tap . @hyp $to-hld-l)
  / (t! mod-tap / @meh $to-hld-l)
)

(deflayer (base)
  _     _     _     _     _     _           _     _     _     _     _     _     _    del
  _     _     _     _     _     _           _     _     _     _     _     _     _    _
  bks   @a    @s    @d    @f    @g          @h    @j    @k    @l    @;    _          _
  _     @z    @x    _     _     _           _     _     _     @.    @/               @rsft
        _     @lalt @lmet            @spc                     @rmet @lalt
)

;; no home row layer, for basic typing
(deflayer (nohr)
  _     _     _     _     _     _           _     _     _     _     _     _     _    del
  _     _     _     _     _     _           _     _     _     _     _     _     _    _
  bks   _     _     _     _     _           _     _     _     _     _     _          _
  _     _     _     _     _     _           _     _     _     _     _                @rsft
        _     @lalt @lmet           @spcl                   @rmet   @ralt
)

(include "lib/autoshift.kbd")

;; auto-shifting layer
(deflayer (as)
  @s`   @s1   @s2   @s3   @s4   @s5         @s6   @s7   @s8   @s9   @s0   @s-   @s=  del
  _     @sq   @sw   @se   @sr   @st         @sy   @su   @si   @so   @sp   @s[   @s]   @s\
  bks   @sa   @ss   @sd   @sf   @sg         @sh   @sj   @sk   @sl   @s;   @s'         _
  _     @sz   @sx   @sc   @sv   @sb         @sn   @sm   @s,   @s.   @s/               @rsft
        _     @lalt @lmet            @spcl                    @rmet @ralt
)

;; symbols layer
(deflayer (sym)
  XX    f1    f2    f3    f4    f5          f6    f7    f8    f9   f10   f11   f12    XX
  XX    XX    @#    @$    @%    @^          @$    @*    [     ]    @::   @->   @=>    XX
  del   @!    @@    @&    @|    @~          -     @+    S-9   S-0  @:    `            @hyp
  @cpw  XX    XX    @&&   @||   esc         @_    =     @{    @}   \                  @cpw
        @hyp  @FN   @SYM2             _                       @SYM2      @FN
)

(deflayer (sym2)
  XX    @『    @』   @「   @」   XX           @«    @»    XX    XX    XX   XX    XX    XX
  XX    XX    XX    @µ    @®   @™           @‹     @›    @“    @”    XX   @「   @」   XX
  caps  @Æ    @§    @°    @𝑓   @~=          @〈    @〉   @‘     @’    @:=  @```       XX
  XX    XX    XX    @©    XX   XX           @《    @》   @{%    @%}   XX              XX
        _     _     _                  _                      _      _
)

(deflayer (num)
  XX    @!    @@    @#    @$    @%         @^    @&    @*    S-9   S-0   @_    =     bks
  XX    XX    XX    XX    XX    S-9        @#    7     8     9     0     @+    /     \
  bks   lctl  lalt  lmet  lsft  S-0        @$    4     5     6     @+    =           ret
  _     XX    XX    XX    XX    @+         ,     1     2     3     .                 rsft
        _     _     @lmet            @spc              0     ent
)

;; ;; macros layer with dynamic macro record/play and word macros
;; (deflayer (macros)
;;   XX    @sec1 @sec2 @sec3 @sec4 @sec5      @sec6 @sec7 @sec8 @sec9 XX    XX    XX    XX
;;   `     @rdm1 @rdm2 @rdm3 @rdm4 @rdm5      XX    XX    @int  @obj  @phz  XX    XX    XX
;;   @dmst @pdm1 @pdm2 @pdm3 @pdm4 @pdm5      @http @fuc  @rtr  @lclh XX    XX          @rtr
;;   XX    @bcz  XX    XX    XX    XX         XX    XX    XX    XX    @ques             XX
;;         _     _     XX                 XX                    XX    XX    XX
;; )

(t! seq vk-to-NOHR (` 1) (layer-switch nohr))
(t! seq vk-to-BASE (` 2) (layer-switch base))
(t! seq vk-to-AS (` 3) (layer-switch as))
(t! seq vk-to-NUM (` 4) (layer-switch num))

;; function layer
;; (deflayer (fn)
;;   XX    @toBS @toNR  @toAS @toNM  XX         XX    XX   XX    XX    XX    XX    XX    XX
;;   XX    ◀◀      ▶⏸    ▶▶   XX     XX         XX    XX   XX    XX    XX    XX    XX    XX
;;   XX    🔇      🔉    🔊    🔅     🔆          ◀     ▼    ▲     ▶     XX    XX          XX
;;   _     @toBS @toNR  @toAS @toNM  XX         home  pgdn pgup  end   XX                _
;;         _     _       _                  _                          _     _
;; )


;; function layer
(deflayer (fn)
  XX    @toBS @toNR @toAS @toNM  XX         XX    XX   XX    XX    XX    XX    XX    XX
  XX    home  ▲     end   XX     XX         home  pgdn pgup  end   XX    XX    XX    XX
  @oSEC ◀     ▼     ▶     XX     XX         ◀     ▼    ▲     ▶     XX    XX          @oSEC
  XX    ◀◀    ▶⏸    ▶▶    XX     XX         🔅    🔆    🔉    🔊    🔇                 _
        _     _     _                  _                           _     _
)

(deflayer (sec)
  XX    @sc_1 @sc_2 @sc_3 @sc_4 @sc_5      @sc_6 @sc_7 @sc_8 @sc_9 @sc_0 XX    XX    XX
  XX    @sc_q @sc_w @sc_e @sc_r @sc_t      @sc_y @sc_u @sc_i @sc_o @sc_p XX    XX    XX
  XX    @sc_a @sc_s @sc_d @sc_f @sc_g      @sc_h @sc_j @sc_k @sc_l @sc_; XX          XX
  XX    @sc_z @sc_x @sc_c @sc_v @sc_b      @sc_n @sc_m @sc_, @sc_. @sc_/              _
        _     _     _                  _                           _     _
)


(deflayer (left-hrm-held)
  _     _     _     _     _     _           _     _     _     _     _     _     _    _
  _     _     _     _     _     _           _     _     _     _     _     _     _    _
  _     lctl  lalt  lmet  lsft  _           _     _     _     _     _     _          _
  _     _     _     _     _     _           _     _     _     _     _                _
        _     _     _                 _                       _     _
)

(deflayer (right-hrm-held)
  _     _     _     _     _     _           _     _     _     _     _     _     _    _
  _     _     _     _     _     _           _     _     _     _     _     _     _    _
  _     _     _     _     _     _           _     rsft  rmet  ralt  rctl  _          _
  _     _     _     _     _     _           _     _     _     _     _                _
        _     _     _                 _                       _     _
)
