(include "lib/symbols.kbd")
(include "lib/words.kbd")

(defcfg
  ;; required for chordsv2
  concurrent-tap-hold yes
  sequence-timeout 1000
)


(defsrc
  esc  🔅   🔆   nop0 nop1 nop2 nop3 ◀◀   ▶⏸   ▶▶   🔇   🔉   🔊
  `    1    2    3    4    5    6    7    8    9    0    -    =   bks
  tab  q    w    e    r    t    y    u    i    o    p    [    ]     \
  caps a    s    d    f    g    h    j    k    l    ;    '        ret
  lsft z    x    c    v    b    n    m    ,    .    /            rsft
      lctl lalt lmet            spc           rmet ralt rctl
)

(defvar
  ;; --- timings ---
  ;; taps
  to-tap-s 40
  to-tap-m 75
  to-tap-l 150

  ;; holds
  to-hld-s 150
  to-hld-m 200
  to-hld-l 400

  ;; chords
  to-crd-s 30
  to-crd-m 50
  to-crd-l 75

  ;; autoshift
  to-as 175

  ;; l/r hand keys
  right-hand-keys (
    ` 1 2 3 4 5 6 7 8 9 0 - =
    [ ] \
    tab ret bks
    q w e r
    a s d f
    z x c v
    spc
    up down left right
  )

  left-hand-keys (
    ` 1 2 3 4 5 6 7 8 9 0 - =
    [ ] \
    tab ret bks
    u i o p
    j k l ;
    m , . /
    spc
    up down left right
  )
)

(deftemplate auto-shift (key)
  (tap-hold-press-timeout $to-as $to-as $key $key (concat "S-" $key))
)

(deftemplate mod-tap (char mod)
  (switch
    ((key-timing 3 less-than 200)) $char break
    () (tap-hold $to-hld-s $to-hld-s $char $mod) break
  )
)

(deftemplate mod-tap-left (char mod)
  (switch
    ((key-timing 3 less-than 200)) $char break
    () (tap-hold-release-keys $to-hld-s $to-hld-m $char $mod $right-hand-keys) break
  )
)

(deftemplate mod-tap-right (char mod)
  (switch
    ((key-timing 3 less-than 200)) $char break
    () (tap-hold-release-keys $to-hld-s $to-hld-m $char $mod $left-hand-keys) break
  )
)

;; common aliases
(defalias
  ;; --- multi ---
  meh (multi lctl lalt lsft)
  hyp (multi lctl lalt lsft lmet)

  ;; layers
  SYM (layer-toggle sym)
  SYM2 (layer-toggle sym2)
  ;; TYP (layer-toggle typ)
  NUM (layer-toggle num)
  MAC (layer-toggle macros)
  FN (layer-toggle fn)

  cpw (caps-word-toggle 1000)

  ;; layer tap holds
  spc (tap-hold 175 175 spc @SYM)
  ;; spc with a longer tap-hold
  spcl (tap-hold 300 300 spc @SYM)


  ;; dynamic macros
  rdm1 (dynamic-macro-record 1)
  pdm1 (dynamic-macro-play 1)
  rdm2 (dynamic-macro-record 2)
  pdm2 (dynamic-macro-play 2)
  rdm3 (dynamic-macro-record 3)
  pdm3 (dynamic-macro-play 3)
  rdm4 (dynamic-macro-record 4)
  pdm4 (dynamic-macro-play 4)
  rdm5 (dynamic-macro-record 5)
  pdm5 (dynamic-macro-play 5)

  ;; layer switching
  toNOHR (layer-switch nohr)
  toBASE (layer-switch base)
  toAS (layer-switch as)
  toNUM (layer-switch num)

  ;; mod-tap keys
  g (t! mod-tap g @FN)
  h (t! mod-tap h @FN)

  a (t! mod-tap-left a lctl)
  s (t! mod-tap-left s lalt)
  d (t! mod-tap-left d lmet)
  f (t! mod-tap-left f lsft)
  j (t! mod-tap-right j rsft)
  k (t! mod-tap-right k rmet)
  l (t! mod-tap-right l ralt)
  ; (t! mod-tap-right ; rctl)
  ;; hyp / meh
  z (t! mod-tap-left z @meh)
  x (t! mod-tap-left x @hyp)
  . (t! mod-tap-right . @hyp)
  / (t! mod-tap-right / @meh)

  ;; auto-shifted keys
  sq (t! auto-shift q)
  sw (t! auto-shift w)
  se (t! auto-shift e)
  sr (t! auto-shift r)
  st (t! auto-shift t)
  sy (t! auto-shift y)
  su (t! auto-shift u)
  si (t! auto-shift i)
  so (t! auto-shift o)
  sp (t! auto-shift p)
  sa (t! auto-shift a)
  ss (t! auto-shift s)
  sd (t! auto-shift d)
  sf (t! auto-shift f)
  sg (t! auto-shift g)
  sh (t! auto-shift h)
  sj (t! auto-shift j)
  sk (t! auto-shift k)
  sl (t! auto-shift l)
  sz (t! auto-shift z)
  sx (t! auto-shift x)
  sc (t! auto-shift c)
  sv (t! auto-shift v)
  sb (t! auto-shift b)
  sn (t! auto-shift n)
  sm (t! auto-shift m)

  s, (t! auto-shift ,)
  s. (t! auto-shift .)
  s` (t! auto-shift `)
  s; (t! auto-shift ;)
  s' (t! auto-shift ')
  s/ (t! auto-shift /)
  s1 (t! auto-shift 1)
  s2 (t! auto-shift 2)
  s3 (t! auto-shift 3)
  s4 (t! auto-shift 4)
  s5 (t! auto-shift 5)
  s6 (t! auto-shift 6)
  s7 (t! auto-shift 7)
  s8 (t! auto-shift 8)
  s9 (t! auto-shift 9)
  s0 (t! auto-shift 0)
  s- (t! auto-shift -)
  s= (t! auto-shift =)
  s[ (t! auto-shift [)
  s] (t! auto-shift ])
  s\ (t! auto-shift \)
)

(defchordsv2
  ;; LEFT HAND
  ;; home row
  (s d) @& $to-crd-s all-released ()
  (d f) @| $to-crd-m all-released ()
  (a f) @! $to-crd-m all-released ()
  (s f) @@ $to-crd-s all-released ()
  (f g) @^ $to-crd-m all-released ()
  ;; top row
  ;; bottom row
  (z x) \  $to-crd-m all-released ()
  (c v) @~ $to-crd-m all-released ()
  (c x) ` $to-crd-m all-released ()
  ;; crosses
  (f e s) @%  $to-crd-l all-released ()

  ;; RIGHT HAND
  ;; home row
  (j k) esc $to-crd-s all-released ()
  (k l) =   $to-crd-s all-released ()
  (l ;) -   $to-crd-m all-released ()
  (j l) @+  $to-crd-s all-released ()
  (j ;) S-' $to-crd-m all-released ()
  (h j) @$  $to-crd-s all-released ()
  ;; top row
  ;; bottom row
  (n m ,) @— $to-crd-l all-released ()
  (m ,) @_ $to-crd-s all-released ()
  (, .) @^ $to-crd-m all-released ()
  ;; crosses
  (j i l) @* $to-crd-l all-released ()
)

(deflayer (base)
  _     _     _     _     _     _           _     _     _     _     _     _     _
  _     _     _     _     _     _           _     _     _     _     _     _     _    del
  _     _     _     _     _     _           _     _     _     _     _     _     _    _
  bks   @a    @s    @d    @f    @g          @h    @j    @k    @l    @;    _          _
  _     @z    @x    _     _     _           _     _     _     @.    @/               _
        _     _     _                @spc                     _     _     _
)

;; no home row layer, for basic typing
(deflayer (nohr)
  _     _     _     _     _     _           _     _     _     _     _     _     _
  _     _     _     _     _     _           _     _     _     _     _     _     _    del
  _     _     _     _     _     _           _     _     _     _     _     _     _    _
  bks   _     _     _     _     _           _     _     _     _     _     _          _
  _     _     _     _     _     _           _     _     _     _     _                _
        _     _     _                 @spcl                   _     _     _
)

;; auto-shifting layer
(deflayer (as)
  _     _     _     _     _     _           _     _     _     _     _     _     _
  @s`   @s1   @s2   @s3   @s4   @s5         @s6   @s7   @s8   @s9   @s0   @s-   @s=  del
  _     @sq   @sw   @se   @sr   @st         @sy   @su   @si   @so   @sp   @s[   @s]   @s\
  bks   @sa   @ss   @sd   @sf   @sg         @sh   @sj   @sk   @sl   @s;   @s'         _
  _     @sz   @sx   @sc   @sv   @sb         @sn   @sm   @s,   @s.   @s/               _
        _     _     _                 @spc                    _     _     _
)

;; symbols layer
(deflayer (sym)
  _     _     _     _     _     _           _     _     _     _     _     _     _
  @meh  f1    f2    f3    f4    f5          f6    f7    f8    f9    f10   f11   f12    XX
  @hyp  @!    @@    @#    @%    @^          @$    @*    @+    -     \     pgup  pgdn   @meh
  @cpw  @&    @|    S-9   [     @{          @}    ]     S-0   =     @dq   `            @hyp
  _     @MAC  @NUM  @FN   @SYM2 @~          @_    -     @SYM2 @FN   @MAC                _
        _     _     _                 _                       _     _     _
)

(deflayer (sym2)
  _     _     _     _     _     _           _     _     _     _     _     _     _
  XX    XX    @§    XX    XX    XX          XX    @〈   @〉   @《   @》  XX     XX     XX
  XX    XX    XX    @==   @®    @™          @=>   @«    @»    @‹    @›   @「    @」    XX
  caps  @&&   @||   @°    @𝑓   @<-          @->   @‘    @’    @“    @”   @::           XX
  XX    XX    XX    @©    XX    XX          @—    @–    @<=   @>=   XX             XX
        _     _     _                  _                      _     _     _
)

(deflayer (num)
  _     _     _     _     _     _          _     _     _     _     _     _     _
  XX    @!    @@    @#    @$    @%         @^    @&    @*    S-9   S-0   @_    =     bks
  XX    XX    XX    XX    XX    S-9        @#    7     8     9     0     @+    /     \
  bks   XX    XX    XX    XX    S-0        @$    4     5     6     @+    =           ret
  _     XX    XX    XX    XX    @+         ,     1     2     3     .                 rsft
        _     _     _                 _                      0     ent   _
)

(include "secrets.kbd")

;; macros layer with dynamic macro record/play and word macros
;; TODO: add more word macros
(deflayer (macros)
  _     _     _     _     _     _          _     _     _     _     _     _     _
  XX    @sec1 @sec2 @sec3 @sec4 @sec5      XX    XX    XX    XX    XX    XX    XX    XX
  `     @rdm1 @rdm2 @rdm3 @rdm4 @rdm5      XX    XX    XX    @#TDO @phz  XX    XX    XX
  XX    @pdm1 @pdm2 @pdm3 @pdm4 @pdm5      @http @fuc  @rtr  XX    XX    XX          @rtr
  _     @bcz  XX    XX    XX    XX         XX    XX    XX    XX    @ques             XX
        _     _     XX                 XX                    XX    XX    XX
)

(deflayer (fn)
  _     _       _       _     _       _          _     _    _     _     _     _     _
  XX    XX      XX      XX    XX      XX         XX    XX   XX    XX    XX    XX    XX    XX
  XX    🔇      🔊      ▶⏸    🔆      XX         XX    XX   XX    XX    XX    XX    XX   XX
  XX    ◀◀      🔉      ▶▶    🔅      XX          ◀     ▼    ▲     ▶    esc   XX          XX
  _     @toBASE @toNOHR @toAS @toNUM  XX         home  pgdn pgup  end   XX                _
        _     _     _                  _                          _     _      _
)
