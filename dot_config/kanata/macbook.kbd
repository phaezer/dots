  _     _     _     _     _     _           _     _     _     _     _     _     _
  XX    @Æ    @§    @°    @𝑓    XX          XX    @〈   @〉   @《   @》  XX     XX     XX
  XX    XX    @==   @®    @™    XX          XX    @«    @»    @‹    @›   @「    @」    XX
  caps  @Æ    @§    @!=   @drp  @[[         @]]   @dlp  @‘    @’    @“   @”            XX
  XX    XX    XX    @©    @!=   @{{         @}}   @—    @<=   @>=   @–                 XX
        _     _     _                  _                      _     _     _
)

(deflayer (num)
  _     _     _     _     _     _          _     _     _     _     _     _     _
  XX    @!    @@    @#    @$    @%         @^    @&    @*    S-9   S-0   @_    =     bks
  XX    XX    XX    XX    XX    S-9        @#    7     8     9     0     @+    /     \
  XX    XX    XX    XX    XX    S-0        @$    4     5     6     @+    =           ret
  _     XX    XX    XX    XX    @+         ,     1     2     3     .                 rsft
        _     _     bks                _                     0     ent   _
)

(include "secrets.kbd")

