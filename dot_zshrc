#! /bin/zsh

# all additional paths should be added here
PATHS=(
    # custom local binaries
    "$HOME/.local/bin"
    # spicetify
    "$HOME/.spicetify"
    # go binaries
    "$HOME/go/bin"
    # rust binaries
    "$HOME/.cargo/bin"
    # windsurf
    "$HOME/.codeium/windsurf/bin"
    # zvm
    "$HOME/.zvm/bin"
    # opencode
    "$HOME/.opencode/bin"
)

# Preferred editor for local and remote sessions
if [[ -n $SSH_CONNECTION ]]; then
    export EDITOR='vim'
else
    export EDITOR='nvim'
fi

# zoxide init
eval "$(zoxide init zsh)"

# bat config
# see: https://github.com/sharkdp/bat
export BAT_THEME="tokyonight_storm"
# use bat as manpager
export MANPAGER="sh -c 'sed -u -e \"s/\\x1B\[[0-9;]*m//g; s/.\\x08//g\" | bat -p -lman'"

# add extra paths
export PATH=$(IFS=:; echo "${PATHS[*]}:$PATH")

# Oh My Zsh configuration.
export ZSH="$HOME/.oh-my-zsh"

source <(fzf --zsh)

# SOPS plugin configuration
source "$HOME/.config/zsh/sops.zsh"

plugins=(
    aliases # helps list the shortcuts that are currently available
    ansible
    aws
    brew
    chezmoi
    colorize # adds color to the output of certain commands
    conda
    direnv
    docker
    docker
    dotenv
    fast-syntax-highlighting
    gh
    git-commit
    git-flow
    gitfast
    golang
    helm
    history
    kubectl
    kubectx
    mise
    npm
    nvm
    opentofu
    poetry
    pyenv
    python
    rust
    sops-crypt
    terraform
    tmux
    zsh-autocomplete
    zsh-autosuggestions
    zsh-syntax-highlighting
)

source $ZSH/oh-my-zsh.sh
eval "$(starship init zsh)"

source "$HOME/.config/zsh/aliases.zsh"
source "$HOME/.config/zsh/functions.zsh"
source "$HOME/.config/zsh/secrets.zsh"
source "$HOME/.config/zsh/fzf.zsh"
source "$HOME/.config/zsh/git.zsh"
source "$HOME/.config/zsh/theme.zsh"

# activate mise
eval "$(~/.local/bin/mise activate zsh)"

# load direnv
eval "$(direnv hook zsh)"
